# Copier ce fichier en apps/api/.env puis adapter.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Laisser vide pour utiliser PGlite (PostgreSQL embarqué, aucun Docker nécessaire en développement).
# Avec docker compose : postgres://carnet:carnet@localhost:5432/carnet
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# Au moins 32 caractères. Générer par : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=7b068a9e03cb53bfed9f861dea60c58f0c6b17751940cbe5
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

CORS_ORIGINS=http://localhost:5173
LOGIN_MAX_ATTEMPTS=5
LOCK_MINUTES=15
RATE_LIMIT_ENABLED=true
